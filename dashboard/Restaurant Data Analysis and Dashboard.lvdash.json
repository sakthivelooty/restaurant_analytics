    {
      "name": "849008ce",
      "displayName": "Top 10 Items",
      "queryLines": [
        "select item_name,\r\n",
        "sum(quantity) as total_quantity \r\n",
        "from dbx_az_projects.`02_silver`.fact_order_items\r\n",
        "group by item_name, order_date\r\n",
        "having order_date between :date_range.min and :date_range.max\r\n",
        "order by total_quantity desc\r\n",
        "limit 10;"
      ],
      "parameters": [
