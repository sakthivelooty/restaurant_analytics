    {
      "name": "9758eca3",
      "displayName": "customer_review-dim-rest",
      "queryLines": [
        "select * from dbx_az_projects.`03_gold`.dim_restaurant_review"
      ]
    },
    {
      "name": "dbcb19d6",
      "displayName": "review trend",
      "queryLines": [
        "select \r\n",
        "    rest.name as resturant_name,\r\n",
        "    date(review_timestamp) as review_date,\r\n",
        "    sum(\r\n",
        "        case \r\n",
        "         when sentiment = 'negative' then 1\r\n",
        "         else 0\r\n",
        "        end \r\n",
        "    ) as negative_review_count,\r\n",
        "    sum(\r\n",
        "        case \r\n",
        "         when sentiment = 'positive' then 1\r\n",
        "         else 0\r\n",
        "        end \r\n",
        "    ) as positive_review_count,\r\n",
        "    sum(\r\n",
        "        case \r\n",
        "         when sentiment = 'neutral' then 1\r\n",
        "         else 0\r\n",
        "        end \r\n",
        "    ) as neutral_review_count\r\n",
        "from dbx_az_projects.`02_silver`.fact_reviews review\r\n",
        "join dbx_az_projects.`02_silver`.dim_resturants rest on rest.restaurant_id = review.restaurant_id\r\n",
        "group by  1,2"
      ]
    },
    {
      "name": "cb7f5a7d",
      "displayName": "Restaurant Reviews Gold Dimension Dataset",
      "queryLines": [
        "select \r\n",
        "\r\n",
        "restaurant_name,\r\n",
        "rating_lable,\r\n",
        "rating_count\r\n",
        "from dbx_az_projects.`03_gold`.dim_restaurant_review\r\n",
        "lateral view STACK(\r\n",
        "    5,\r\n",
        "    \"5 STAR\", rating_5_count,\r\n",
        "    \"4 STAR\", rating_4_count,\r\n",
        "    \"3 STAR\", rating_3_count,\r\n",
        "    \"2 STAR\", rating_2_count,\r\n",
        "    \"1 STAR\", rating_1_count\r\n",
        ") AS rating_lable, rating_count\r\n",
        "\r\n",
        "-- \"rest_name\", \"rating_lable\", 'rating_count'"
      ]
    },
    {
      "name": "4d84e302",
      "displayName": "Restaurant Daily Issue Summary Report",
      "queryLines": [
        "select \r\n",
        "rst.name as restaurant_name,\r\n",
        "date(fr.review_timestamp) as date,\r\n",
        "\r\n",
        "sum(\r\n",
        "    case \r\n",
        "        when issue_delivery = 'true' then 1\r\n",
        "        else 0\r\n",
        "    end\r\n",
        ") as delivery_issues,\r\n",
        "\r\n",
        "sum(\r\n",
        "    case \r\n",
        "        when issue_food_quality = 'true' then 1\r\n",
        "        else 0\r\n",
        "    end\r\n",
        ") as food_quality_issue,\r\n",
        "sum(\r\n",
        "    case \r\n",
        "        when issue_pricing = 'true' then 1\r\n",
        "        else 0\r\n",
        "    end\r\n",
        ") as pricing_issues,\r\n",
        "sum(\r\n",
        "    case \r\n",
        "        when issue_portion_size = 'true' then 1\r\n",
        "        else 0\r\n",
        "    end\r\n",
        ") as portion_size_issue\r\n",
        "from dbx_az_projects.`02_silver`.fact_reviews fr\r\n",
        "join dbx_az_projects.`02_silver`.dim_resturants rst on rst.restaurant_id = fr.restaurant_id\r\n",
        "group by 1, 2"
      ]
    },
    {
      "name": "a4d138e0",
      "displayName": "Customer Feedback Insights from Silver Project Data",
      "queryLines": [
        "select \r\n",
        "rst.name as restaurant_name, \r\n",
        "date(review_timestamp) as review_date,\r\n",
        "review_text as rating \r\n",
        "from dbx_az_projects.`02_silver`.fact_reviews fr\r\n",
        "join dbx_az_projects.`02_silver`.dim_resturants rst on rst.restaurant_id = fr.restaurant_id\r\n",
        "where sentiment = 'positive'\r\n",
        "order by review_date desc\r\n"
      ]
    }
  ],
